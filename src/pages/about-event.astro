---
import MasterNavigator from '../components/navigation/MasterNavigator.astro';
import StageShell from '../components/stage/StageShell.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="About Event | Qiskit Event Website"
  description="Neutral technical route shell for the future About Event page."
>
  <StageShell id="about-event-stage" headingId="about-event-heading">
    <MasterNavigator slot="navigation" currentPath={Astro.url.pathname} />
    <div slot="identity">
      <h1 id="about-event-heading">About Event</h1>
      <p>Neutral route shell only; event content and visual design are not implemented.</p>
    </div>
  </StageShell>
</SiteLayout>
