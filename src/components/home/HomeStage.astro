---
import StageShell from '../stage/StageShell.astro';
import HomeLayeredBackground from './HomeLayeredBackground.astro';
import SchrodingerBox from './SchrodingerBox.astro';
import '../../styles/home.css';
---

<StageShell id="home-stage" headingId="home-heading">
  <div slot="identity" class="home-stage__identity-content">
    <p class="home-stage__kicker">Quantum / Event</p>
    <h1 id="home-heading" class="home-stage__title">
      <span>Qiskit</span>
      {' '}
      <span>Event</span>
    </h1>
    <p class="home-stage__lede">
      <span class="home-stage__lede-line">Explore quantum computing</span>{' '}
      <span class="home-stage__lede-line">through ideas, interaction,</span>{' '}
      <span class="home-stage__lede-line">and experimentation.</span>
    </p>
  </div>

  <div slot="background" class="home-stage__background-art">
    <HomeLayeredBackground />
  </div>

  <SchrodingerBox slot="subject" />

  <script>
    import '../../scripts/schrodinger-box';
  </script>
</StageShell>
