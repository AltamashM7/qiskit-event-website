---

<div class="home-layered-background" data-home-layered-background aria-hidden="true">
  <picture class="home-layered-background__base">
    <source
      media="(min-width: 48rem)"
      srcset="/assets/home/background/layered/web/desktop/base/home-probability-field-base-desktop.webp"
      type="image/webp"
    />
    <img
      src="/assets/home/mobile-layered/home-mobile-layered-base-v1.png"
      alt=""
      width="841"
      height="1870"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="home-layered-background__waves home-layered-background__waves--desktop" data-wave-device="desktop">
    {
      desktopWaves.map((wave) => (
        <span
          class={`home-layered-background__wave ${wave.className}`}
          data-wave-id={wave.id}
          data-wave-asset={wave.asset}
        ></span>
      ))
    }
  </div>

  <div class="home-layered-background__waves home-layered-background__waves--mobile" data-wave-device="mobile">
    {
      mobileWaves.map((wave) => (
        <span
          class={`home-layered-background__wave ${wave.className}`}
          data-wave-id={wave.id}
          data-wave-family={wave.family}
          data-wave-asset={wave.asset}
        ></span>
      ))
    }
  </div>

  <span
    class="home-layered-background__overlay"
    data-layered-background-overlay
    data-overlay-asset="/assets/home/background/layered/web/desktop/overlay/home-probability-field-overlay-desktop.webp"
    data-overlay-mobile-asset="/assets/home/mobile-layered/home-mobile-layered-overlay-v1.png"
  ></span>
</div>
