<div class="home-layered-background" data-home-layered-background aria-hidden="true">
  <picture class="home-layered-background__base">
    <source
      media="(min-width: 48rem)"
      srcset="/assets/home/background/layered/web/desktop/base/home-probability-field-base-desktop.webp"
      type="image/webp"
    />
    <img
      src="/assets/home/background/home-probability-field-frame-a-v1.png"
      alt=""
      width="1672"
      height="941"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
  </picture>

  <div class="home-layered-background__waves">
    <span
      class="home-layered-background__wave home-layered-background__wave--01"
      data-wave-id="wave-01-thick-cream-upper"
      data-wave-asset="/assets/home/background/layered/web/desktop/waves/wave-01-thick-cream-upper.webp"
    ></span>
    <span
      class="home-layered-background__wave home-layered-background__wave--02"
      data-wave-id="wave-02-thick-cream-lower"
      data-wave-asset="/assets/home/background/layered/web/desktop/waves/wave-02-thick-cream-lower.webp"
    ></span>
    <span
      class="home-layered-background__wave home-layered-background__wave--03"
      data-wave-id="wave-03-thin-yellow"
      data-wave-asset="/assets/home/background/layered/web/desktop/waves/wave-03-thin-yellow.webp"
    ></span>
    <span
      class="home-layered-background__wave home-layered-background__wave--04"
      data-wave-id="wave-04-thin-ivory"
      data-wave-asset="/assets/home/background/layered/web/desktop/waves/wave-04-thin-ivory.webp"
    ></span>
    <span
      class="home-layered-background__wave home-layered-background__wave--05"
      data-wave-id="wave-05-dashed-white-upper"
      data-wave-asset="/assets/home/background/layered/web/desktop/waves/wave-05-dashed-white-upper.webp"
    ></span>
    <span
      class="home-layered-background__wave home-layered-background__wave--06"
      data-wave-id="wave-06-dashed-white-lower"
      data-wave-asset="/assets/home/background/layered/web/desktop/waves/wave-06-dashed-white-lower.webp"
    ></span>
    <span
      class="home-layered-background__wave home-layered-background__wave--07"
      data-wave-id="wave-07-halftone-yellow-band"
      data-wave-asset="/assets/home/background/layered/web/desktop/waves/wave-07-halftone-yellow-band.webp"
    ></span>
    <span
      class="home-layered-background__wave home-layered-background__wave--08"
      data-wave-id="wave-08-translucent-cream-ribbon"
      data-wave-asset="/assets/home/background/layered/web/desktop/waves/wave-08-translucent-cream-ribbon.webp"
    ></span>
  </div>

  <span
    class="home-layered-background__overlay"
    data-layered-background-overlay
    data-overlay-asset="/assets/home/background/layered/web/desktop/overlay/home-probability-field-overlay-desktop.webp"
  ></span>
</div>
