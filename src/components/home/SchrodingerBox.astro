<button
  class="schrodinger-box"
  type="button"
  data-schrodinger-box
  data-locked="false"
  data-revealed="false"
  aria-label="Schrödinger's box"
  aria-pressed="false"
>
  <span class="schrodinger-box__art" aria-hidden="true">
    <img
      class="schrodinger-box__image schrodinger-box__image--closed"
      src="/assets/home/schrodinger/box-closed-v1.png"
      alt=""
      width="1086"
      height="1448"
      loading="eager"
      decoding="async"
    />
    <img
      class="schrodinger-box__image schrodinger-box__image--reveal"
      src="/assets/home/schrodinger/box-reveal-v1.png"
      alt=""
      width="1086"
      height="1448"
      loading="eager"
      decoding="async"
    />
  </span>
</button>
