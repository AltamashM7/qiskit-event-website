---
import type { Organizer } from '../../data/event';

interface Props {
  organizers: readonly Organizer[];
}

const { organizers } = Astro.props;
---

<ul class="formal-brand-strip" data-organizer-list>
  {organizers.map((organizer, index) => (
    <li>
      <small>{organizer.category ?? `Credit ${String(index + 1).padStart(2, '0')}`}</small>
      {organizer.logo ? (
        <img src={organizer.logo} alt={organizer.name} loading="lazy" />
      ) : (
        <span>{organizer.name}</span>
      )}
      {organizer.category && <small>{organizer.category}</small>}
    </li>
  ))}
</ul>
