---
interface Props {
  statement: string;
  paragraphs: readonly string[];
  asset?: string;
  assetAlt?: string;
}

const { statement, paragraphs, asset, assetAlt = '' } = Astro.props;
---

<div class:list={['formal-editorial-split', { 'formal-editorial-split--illustrated': asset }]}>
  <div class="formal-editorial-split__copy">
    <p class="formal-editorial-split__label">The event in one line</p>
    <p class="formal-editorial-split__statement">{statement}</p>
    <div class="formal-editorial-split__supporting-copy">
      {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  {asset && (
    <figure class="formal-editorial-split__visual">
      <div class="formal-editorial-split__visual-head" aria-hidden="true">
        <span>LEARN</span>
        <span>BUILD</span>
        <span>EXPLORE</span>
      </div>
      <div class="formal-editorial-split__art-frame">
        <img src={asset} alt={assetAlt} aria-hidden={assetAlt === '' ? 'true' : undefined} loading="lazy" />
      </div>
      <figcaption>Editorial study / 01</figcaption>
    </figure>
  )}
</div>
